# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# шаблоны без секретов можно коммитить
!.env.example
!.env.local.example

# vercel
.vercel

# WhatsApp-шлюз: сессия и зависимости
/whatsapp-server/auth/
/whatsapp-server/node_modules/
# скачанный cloudflared.exe для публичного туннеля
/whatsapp-server/.bin/
# адрес туннеля и логи запуска — создаются на компьютере
/whatsapp-server/gateway-url.txt
/whatsapp-server/start-public.log
/whatsapp-server/start-public.out.log

# typescript
*.tsbuildinfo
next-env.d.ts
