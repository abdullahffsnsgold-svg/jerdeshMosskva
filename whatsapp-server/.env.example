# Скопируйте в .env и замените на свою строку.
# На Render/Railway задайте эти переменные в панели сервиса.
WHATSAPP_API_SECRET=замените-на-длинную-случайную-строку
PORT=5001
# Папка сессии WhatsApp. На хостинге должна лежать на постоянном диске.
WHATSAPP_SESSION_DIR=auth

# Нужны, чтобы шлюз сам записывал свой актуальный адрес в Supabase
# (таблица public.gateway_config, скрипт supabase/gateway-config.sql).
# Ключ service_role: Supabase → Project Settings → API.
# Он даёт полный доступ к базе, поэтому лежит только в этом локальном файле.
SUPABASE_URL=https://ваш-проект.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ваш-service-role-ключ
